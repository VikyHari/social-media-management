# Copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
APP_URL=http://localhost:3000

# Local PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://creator:creator@localhost:5440/creator_growth?schema=public

# Generate each with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars
# AES-256-GCM key used to encrypt social OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars

# Claude API (AI engine)
ANTHROPIC_API_KEY=

# Social platform OAuth apps (Phase 2 - Meta covers Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
