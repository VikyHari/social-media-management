# Copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
APP_URL=http://localhost:3000

# Local PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://creator:creator@localhost:5440/creator_growth?schema=public

# Generate each with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars
# AES-256-GCM key used to encrypt social OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars

# Claude API (AI engine)
ANTHROPIC_API_KEY=

# Social platform OAuth apps (Phase 2)
# One Meta Developer app (developers.facebook.com) provides BOTH credential pairs below,
# but they are different values — Instagram Business Login has its own App ID/Secret,
# separate from the app's main (Facebook) App ID/Secret. See README "Connecting social accounts".
#
# Facebook Login for Business (Meta app's main App ID/Secret) — Facebook Pages
META_APP_ID=
META_APP_SECRET=
# Instagram Business Login (App Dashboard > Instagram > API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Google Cloud OAuth 2.0 Client (console.cloud.google.com) — YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
