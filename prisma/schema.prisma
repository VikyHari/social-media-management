// AI Creator Growth Manager - database schema
// Tables are snake_case via @@map; models are PascalCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & security (Phase 0/1)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions        Session[]
  auditLogs       AuditLog[]
  aiConversations AiConversation[]
  aiUsageLogs     AiUsageLog[]
  creatorProfile  CreatorProfile?
  goals           Goal[]
  socialAccounts  SocialAccount[]

  @@map("users")
}

/// DB-backed login session. Only a hash of the cookie token is stored.
model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")
  userAgent  String?   @map("user_agent")

  @@index([userId])
  @@map("sessions")
}

/// Sensitive actions: connect/disconnect accounts, approvals, publishing, profile changes.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// AI engine (Phase 1) — generic, reusable across every feature that talks to
// Claude: onboarding interview, later ad-hoc creator chat, content generation.
// Domain-specific data (e.g. the derived creator profile) lives in its own
// module and its own tables; this is just "what was said and what it cost".
// ---------------------------------------------------------------------------

/// A multi-turn exchange with Claude, tagged by `purpose` (e.g. "onboarding",
/// "chat", "content.script") so callers can filter their own conversations.
model AiConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages       AiMessage[]
  usageLogs      AiUsageLog[]
  creatorProfile CreatorProfile?

  @@index([userId, purpose])
  @@map("ai_conversations")
}

/// One turn in an AiConversation.
model AiMessage {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// One Claude API call. Token counts are OBSERVED (straight from the API
/// response); estimatedCostUsd is CALCULATED from a pricing table that needs
/// verification against Anthropic's current pricing before being trusted for
/// real budgeting — see src/modules/ai/pricing.ts.
model AiUsageLog {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId   String?         @map("conversation_id")
  conversation     AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  purpose          String
  model            String
  inputTokens      Int             @map("input_tokens")
  outputTokens     Int             @map("output_tokens")
  estimatedCostUsd Float?          @map("estimated_cost_usd")
  latencyMs        Int             @map("latency_ms")
  createdAt        DateTime        @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Creator intelligence (Phase 1) — what the AI has learned about the creator
// from the onboarding interview. One profile per user; it only comes into
// existence once the interview concludes (no separate "draft" status: the
// AiConversation itself is the in-progress state). The AI updates it over
// time as it learns more (Part 24/62) — this is the current snapshot, not a
// history; add a revision table later if diffing profile changes matters.
// ---------------------------------------------------------------------------

model CreatorProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  primaryNiche    String   @map("primary_niche")
  secondaryNiches String[] @map("secondary_niches")
  interests       String[]
  skills          String[]
  targetAudience  String   @map("target_audience")
  platforms       String[]
  contentFormats  String[] @map("content_formats")
  language        String
  strengths       String[]
  weaknesses      String[]
  equipment       String[]
  budget          String
  timeAvailable   String   @map("time_available")
  experienceLevel String   @map("experience_level")
  existingContent String?  @map("existing_content")
  competitors     String[]
  monetizationGoals String @map("monetization_goals")
  brandPositioning  String @map("brand_positioning")

  /// Initial AI-suggested starting point (e.g. [{name, weightPercent, rationale}]).
  /// Superseded by performance-driven pillars once Phase 4 analytics exist (Part 29).
  contentPillars Json?   @map("content_pillars")
  rawNotes       String? @map("raw_notes")

  /// The onboarding AiConversation this profile was derived from, for provenance.
  sourceConversationId String?         @unique @map("source_conversation_id")
  sourceConversation   AiConversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("creator_profiles")
}

model Goal {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorProfileId String?         @map("creator_profile_id")

  description String
  category    String?
  targetValue String?   @map("target_value")
  targetDate  DateTime? @map("target_date")
  /// "active" | "achieved" | "abandoned" — enforced by Zod at the input boundary.
  status      String    @default("active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("goals")
}

// ---------------------------------------------------------------------------
// Social platform connections (Phase 2). Official OAuth only (Part 25/45) —
// no scraping, no password capture. Tokens are encrypted at rest
// (src/lib/crypto.ts, AES-256-GCM, TOKEN_ENCRYPTION_KEY); this schema never
// stores a plaintext token. Metrics ingestion (writing PlatformMetric rows)
// is a separate, later task — these tables exist now so the connection flow
// has somewhere real to write to.
// ---------------------------------------------------------------------------

model SocialAccount {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "instagram" | "facebook" | "youtube" — enforced by Zod at the input boundary.
  platform String

  /// The platform's id for the connected asset (IG/FB Page id, YouTube channel id).
  externalAccountId   String  @map("external_account_id")
  externalAccountName String? @map("external_account_name")

  accessTokenEncrypted  String  @map("access_token_encrypted")
  refreshTokenEncrypted String? @map("refresh_token_encrypted")
  scopes                String[]
  tokenExpiresAt        DateTime? @map("token_expires_at")

  /// "connected" | "expired" | "revoked" | "error" — enforced by Zod at the input boundary.
  status       String  @default("connected")
  lastError    String? @map("last_error")
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  metrics PlatformMetric[]

  @@unique([userId, platform, externalAccountId])
  @@index([userId])
  @@map("social_accounts")
}

/// One OBSERVED metric value for one connected account on one day (Part 26/57).
/// Always raw platform data — CALCULATED/INFERRED/PREDICTED values belong to
/// their own table once the analytics module (Phase 3) exists; never mixed in here.
model PlatformMetric {
  id              String        @id @default(uuid())
  socialAccountId String        @map("social_account_id")
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  metricDate DateTime @map("metric_date")
  metricType String   @map("metric_type")
  value      Float

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([socialAccountId, metricDate, metricType])
  @@index([socialAccountId, metricDate])
  @@map("platform_metrics")
}
